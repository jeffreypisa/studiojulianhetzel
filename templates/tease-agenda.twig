<div class="tease tease-agenda">
	<div class="row">
		<div class="col">
			{{ item.datum|date('d-m-Y') }} 
		</div>
		<div class="col-auto">
			<a href="{{ item.ticketlink }}" target="_blank" class="blocklink">Tickets</a>
		</div>
	</div>
	{% if item.project %}
		{{ Post(item.project).title }}{% if item.locatie %} | {% endif %}
	{% endif %}
	{{ item.locatie }}
</div>
